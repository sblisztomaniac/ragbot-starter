# Meta Llama API Configuration (for chat completions)
META_API_KEY=your-meta-llama-api-key-here
META_BASE_URL=https://api.llama.com/compat/v1
META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Upstash Vector (vector database + built-in embeddings)
# 1. Create a free account at https://console.upstash.com
# 2. Create a Vector index and select embedding model: BAAI/bge-small-en-v1.5
# 3. Open the index -> "REST API" and copy the URL + token below
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-vector-rest-token
# Namespace to store/query (leave blank to use the default namespace)
UPSTASH_NAMESPACE=
# How many chunks to retrieve per query
UPSTASH_TOP_K=5
# Minimum similarity score 0-1 (0 = no filtering). Tune after seeding with testUpstash.js
UPSTASH_SCORE_THRESHOLD=0

# Get your Meta Llama API key at: https://www.llama.com/llama-stack/
# After setting the Upstash vars, seed the knowledge base:  npm run seed:upstash
